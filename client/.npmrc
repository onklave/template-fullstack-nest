# Turn the `engines` field in package.json from a warning into a hard failure.
#
# Without this, `npm ci` on an unsupported Node prints an EBADENGINE *warning*
# and installs anyway; the toolchain then refuses to run further down the
# chain, in a message that has nothing to do with the command you typed. The
# Angular CLI in particular refuses on anything below the version in `engines`.
# Fail at install, where the fix (`nvm use`, see /.nvmrc) is obvious.
#
# npm reads the .npmrc nearest the package being installed, so each service
# needs its own — a root one would not be consulted from client/ or server/.
#
# NEVER put a registry token in this file. It is committed, and it is copied
# into the Docker build context.
engine-strict=true
